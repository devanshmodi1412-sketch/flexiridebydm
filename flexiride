<script>

// Show homepage
function showHome() {
    document.getElementById("homepage").style.display = "block";

    document.querySelectorAll(".category-page").forEach(function(page) {
        page.classList.remove("active");
    });

    window.scrollTo(0, 0);
}

// Show individual category
function showPage(category) {
    document.getElementById("homepage").style.display = "none";

    document.querySelectorAll(".category-page").forEach(function(page) {
        page.classList.remove("active");
    });

    document.getElementById(category).classList.add("active");

    window.scrollTo(0, 0);
}

// Handle direct category links
function handleRoute() {
    var category = window.location.hash.substring(1);

    if (["daily", "pro", "premium", "electric"].includes(category)) {
        showPage(category);
    } else {
        showHome();
    }
}

window.addEventListener("hashchange", handleRoute);
window.addEventListener("load", handleRoute);

// Contact form demonstration
document.getElementById("contactForm").addEventListener("submit", function(event) {
    event.preventDefault();

    document.getElementById("message").textContent =
        "This is a demo form. No enquiry has been sent.";

    this.reset();
});

</script>

